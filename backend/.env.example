# Copy this file to backend/.env and fill it in. Then start the server with:
#   uvicorn app.main:app --reload --env-file .env
# backend/.env is ignored by git: never commit real secrets.

# SSO (OpenID Connect). Google by default. For Microsoft Entra ID use the
# tenant-specific URL (not "common"):
#   https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
SSO_METADATA_URL=https://accounts.google.com/.well-known/openid-configuration
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# Fixed random values keep users signed in across restarts. Generate each one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TOKEN_SECRET=
SESSION_SECRET=

FRONTEND_URL=http://localhost:5173

# Access point (kiosk). The key is typed once on the kiosk's setup screen.
TERMINAL_KEY=dev-terminal-key
# Face matching: accept below the threshold, with this margin over the second best.
FACE_MATCH_THRESHOLD=0.5
FACE_MATCH_MARGIN=0.05

# QR codes. QR_SECRET must be different from TOKEN_SECRET (generate it the same way).
QR_SECRET=
QR_TTL_SECONDS=60

# --- Online demo only (see "Online demo" in the README) ---
# Face descriptors are biometric data: the cloud server must not receive them.
# FACE_RECOGNITION_ENABLED=false
# First admin of an empty database, SSO only (no demo admin with a known password).
# INITIAL_ADMIN_EMAIL=you@example.com
# PostgreSQL (Supabase). Use the "Session pooler" connection string.
# DATABASE_URL=postgresql://postgres.<project>:<password>@<host>.pooler.supabase.com:5432/postgres
