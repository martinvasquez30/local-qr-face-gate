# Copy this file to backend/.env and fill it in. Then start the server with:
#   uvicorn app.main:app --reload --env-file .env
# backend/.env is ignored by git: never commit real secrets.

# SSO (OpenID Connect). Google by default. For Microsoft Entra ID use the
# tenant-specific URL (not "common"):
#   https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
SSO_METADATA_URL=https://accounts.google.com/.well-known/openid-configuration
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# Fixed random values keep users signed in across restarts. Generate each one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TOKEN_SECRET=
SESSION_SECRET=

FRONTEND_URL=http://localhost:5173
