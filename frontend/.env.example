VITE_API_BASE_URL=http://localhost:8000
# Name on the SSO button. Must match the provider configured in the backend.
VITE_SSO_PROVIDER_NAME=Google
# "false" only in the online demo: hides the face pages; the kiosk reads QR codes only.
# Must match FACE_RECOGNITION_ENABLED in the backend.
VITE_FACE_RECOGNITION_ENABLED=true
